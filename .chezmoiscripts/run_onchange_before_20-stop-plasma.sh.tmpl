#!/bin/sh
# Re-runs whenever the Plasma layout or activity config in this repo changes:
# appletsrc {{ include "dot_config/private_plasma-org.kde.plasma.desktop-appletsrc" | sha256sum }}
# activities {{ include "dot_config/private_kactivitymanagerdrc" | sha256sum }}
#
# plasmashell saves its in-memory panel layout to
# plasma-org.kde.plasma.desktop-appletsrc when it exits, and kactivitymanagerd
# rewrites kactivitymanagerdrc. Stop both before chezmoi writes those files,
# otherwise they overwrite the new config. The matching
# run_onchange_after_90-start-plasma script starts them again.
set -u

if pgrep -x plasmashell >/dev/null 2>&1; then
    echo "==> Stopping plasmashell so the new panel layout is not overwritten"
    kquitapp6 plasmashell >/dev/null 2>&1 || pkill -x plasmashell
    i=0
    while pgrep -x plasmashell >/dev/null 2>&1 && [ "$i" -lt 50 ]; do
        sleep 0.2
        i=$((i + 1))
    done
fi

# Stopping the activity manager lets the repo's activity ID take effect, so the
# desktop (wallpaper/folder view) settings attach to the current activity.
systemctl --user stop plasma-kactivitymanagerd.service >/dev/null 2>&1 || true
exit 0
